{
  "name": "missuenos-clientes",
  "version": "2.0.0",
  "description": "Sistema Integrado de Gestão Comercial, Estoque, Financeiro e Fiscal (ERP White-Label Mis Sueños)",
  "port": 3000,
  "main": "scripts/consultar.js",
  "type": "module",
  "scripts": {
    "converter": "python scripts/converter_enderecos.py",
    "consultar": "infisical run --silent -- node scripts/consultar.js",
    "web": "infisical run --silent -- node scripts/servidor_web.js",
    "migrar:turso": "infisical run --silent -- node scripts/migrar_turso.js",
    "migrar:v2": "infisical run --silent -- node scripts/migrar_schema_v2.js",
    "importar:ncm": "infisical run --silent -- node scripts/importar_ncm.js",
    "configurar-ramo": "infisical run --silent -- node scripts/configurar_ramo.js"
  },
  "keywords": [
    "clientes",
    "sqlite",
    "enderecos",
    "extrator",
    "mis-suenos",
    "erp",
    "turso"
  ],
  "author": "Gustavo Rosa Informática",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@libsql/client": "^0.18.0",
    "dotenv": "^18.0.8"
  }
}
