{
  "name": "missuenos-clientes",
  "version": "2.0.0",
  "description": "Sistema de Gestão Integrada Mis Sueños ERP",
  "port": 3000,
  "main": "scripts/servidor_web.js",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "web": "node scripts/servidor_web.js",
    "web:infisical": "infisical run --silent -- node scripts/servidor_web.js",
    "promover:prod": "node scripts/promover_producao.js",
    "consultar": "node scripts/consultar.js",
    "migrar:turso": "infisical run --silent -- node scripts/migrar_turso.js",
    "migrar:v2": "node scripts/migrar_schema_v2.js",
    "importar:ncm": "node scripts/importar_ncm.js",
    "configurar-ramo": "node scripts/configurar_ramo.js"
  },
  "keywords": [
    "clientes",
    "sqlite",
    "producao",
    "mis-suenos",
    "erp"
  ],
  "author": "Gustavo Rosa Informática",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@libsql/client": "^0.18.0",
    "dotenv": "^18.0.8"
  }
}
