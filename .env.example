# ==============================================================================
# CONFIGURAÇÕES DE NUVEM: TURSO CLOUD + CLOUDFLARE R2
# Autor: Gustavo Rosa Informática
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TURSO CLOUD (Banco de Dados Relacional - SQLite Serverless Global)
# Organizações Separadas: Crie uma Organização para a "missuenos" e outra para "gustavorosainformatica"
# No CLI:
#   turso org create missuenos-org
#   turso org switch missuenos-org
#   turso db create missuenos-db
#   turso db show missuenos-db --url
#   turso db tokens create missuenos-db
# ------------------------------------------------------------------------------
TURSO_DATABASE_URL="libsql://missuenos-db-missuenos-org.turso.io"
TURSO_AUTH_TOKEN="seu_token_jwt_do_turso_aqui"

# ------------------------------------------------------------------------------
# 2. CLOUDFLARE R2 (Armazenamento de Fotos, Ordens de Serviço, PDFs e Notas)
# 10 GB gratuitos/mês + Zero taxas de tráfego de download (egress gratuito)
# No painel da Cloudflare (dash.cloudflare.com -> R2 Object Storage):
#   - Crie o Bucket: missuenos-storage
#   - Gere um API Token R2 com permissão de Leitura e Escrita
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID="seu_cloudflare_account_id"
R2_ACCESS_KEY_ID="sua_access_key_id_do_r2"
R2_SECRET_ACCESS_KEY="sua_secret_access_key_do_r2"
R2_BUCKET_NAME="missuenos-storage"

# URL pública opcional (se habilitar o domínio público r2.dev ou subdomínio personalizado):
# Exemplo: https://pub-xxxxxxxx.r2.dev ou https://arquivos.missuenos.com.br
R2_PUBLIC_URL=""

# ------------------------------------------------------------------------------
# 3. CONFIGURAÇÕES LOCAIS DO SERVIDOR
# ------------------------------------------------------------------------------
PORT=3000
