# Variáveis de ambiente e credenciais
.env
.env.local
.env.*.local

# Dependências
node_modules/

# Uploads locais de mídia
public/uploads/*
!public/uploads/.gitkeep

# Arquivos de banco local SQLite temporários e logs
*.sqlite
*.db
*.log
npm-debug.log*
yarn-debug.log*
.vercel

# Blindagem Zero-PII: Proibido rastrear carteira de clientes ou exportações estáticas no Git
public/dados_clientes.js
database/*.csv
database/*.json
!database/schema.sql
ENDEREÇOS DE ENVIO/

# Ignorar apenas arquivos temporários de auth, nunca código-fonte
auth_token*.json
.auth/
